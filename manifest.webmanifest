{
  "name": "ARGUS — AR Vision Assistant",
  "short_name": "ARGUS",
  "description": "On-device augmented-reality vision assistant. YOLOv8 object recognition, spoken call-outs, target locking and capture logging — all running locally on your phone, fully offline.",
  "id": "argus-ar-vision",
  "start_url": "./",
  "scope": "./",
  "display": "fullscreen",
  "display_override": ["fullscreen", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#02060c",
  "theme_color": "#02060c",
  "lang": "en-GB",
  "dir": "ltr",
  "categories": ["utilities", "productivity", "photo"],
  "prefer_related_applications": false,
  "launch_handler": { "client_mode": "navigate-existing" },
  "icons": [
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" },
    { "src": "icons/icon-180.png", "sizes": "180x180", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Quick capture", "short_name": "Capture", "url": "./?action=capture", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Situation report", "short_name": "Sitrep", "url": "./?action=status", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Configuration", "short_name": "Setup", "url": "./?action=settings", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
