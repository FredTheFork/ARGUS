{
  "name": "ARGUS — Visual Agent",
  "short_name": "ARGUS",
  "description": "On-device visual agent. ~1800-class recognition with fine-grained naming, colour and material analysis, text and brand reading, pose and gesture sensing, spoken answers and a heads-up display built for glasses. Nothing leaves the device.",
  "id": "argus-ar-vision",
  "start_url": "./",
  "scope": "./",
  "display": "fullscreen",
  "display_override": ["fullscreen", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#02060c",
  "theme_color": "#02060c",
  "lang": "en-GB",
  "dir": "ltr",
  "categories": ["utilities", "productivity", "photo"],
  "prefer_related_applications": false,
  "launch_handler": { "client_mode": "navigate-existing" },
  "icons": [
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" },
    { "src": "icons/icon-180.png", "sizes": "180x180", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Quick capture", "short_name": "Capture", "url": "./?action=capture", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Situation report", "short_name": "Sitrep", "url": "./?action=status", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Configuration", "short_name": "Setup", "url": "./?action=settings", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
